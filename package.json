{
  "name": "money-owed-tracker-block-a",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13 <23"
  },
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test tests/*.test.js",
    "snapshot:db": "node scripts/create-db-snapshot.mjs",
    "restore:db": "node scripts/restore-db-snapshot.mjs",
    "test:lane-d": "node --test tests/lane-d-*.test.js",
    "accounting:check": "node scripts/accounting-check.mjs && node --test tests/money.test.js tests/ledger.test.js tests/exact-money-migration.test.js tests/reporting.test.js tests/wave0-baseline.test.js tests/pdf.test.js tests/xlsx.test.js tests/insights.test.js tests/bank-feed.test.js tests/bank-feed-server.test.js tests/accounting-*.test.js tests/lane-b-mode-server.test.js && node scripts/accounting-bank-feed-check.mjs",
    "test:wave4": "node --test tests/release-wave-4-desktop-tablet.test.js",
    "test:wave8-9": "node --test tests/wave8-security.test.js tests/wave9-recovery.test.js",
    "test:wave11-12": "node --test tests/release-wave-11-accessibility.test.js tests/release-wave-12-scale.test.js",
    "test:wave13": "node --test tests/release-wave-13-production-smoke.test.js",
    "test:wave14": "playwright test e2e/visual-audit-matrix.spec.mjs e2e/visual-audit-states.spec.mjs e2e/visual-audit-overlays.spec.mjs --workers=1",
    "test:wave5": "node --test tests/release-wave-5-pwa.test.js",
    "test:wave10": "playwright test e2e/release-critical.spec.mjs --workers=1",
    "test:wave15": "node --test tests/release-wave-15-final-rc.test.js tests/release-wave-7-import-export.test.js tests/wave8-security.test.js tests/wave9-recovery.test.js tests/release-wave-5-pwa.test.js tests/release-wave-13-production-smoke.test.js tests/release-wave-14-visual-audit.test.js",
    "test:offline-a": "node --test tests/offline-block-a.test.js tests/release-wave-5-pwa.test.js"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0"
  }
}
